{
  "name": "dsh-sidebar-usage",
  "version": "0.1.0",
  "description": "Keeps DeepSeek usage and account balance in a bar at the bottom of the DeepSeek Harness window.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YQzhangsan/dsh-sidebar-usage.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "usage",
    "balance",
    "billing"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
